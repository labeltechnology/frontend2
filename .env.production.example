# Variables lues À LA COMPILATION (Vite les inscrit dans le bundle).
# Les définir sur le serveur après le build n'a AUCUN effet : elles doivent
# être présentes au moment de `npm run build`.
#
# Copier ce fichier en `.env.production` avant de compiler, ou passer les
# variables en ligne de commande :
#   VITE_API_BASE_URL= npm run build

# Racine de l'API.
#
#   vide  → même origine que la page. Le serveur web sert le frontend et
#           relaie /api et /ws vers le backend (voir nginx.conf). C'est le
#           montage recommandé : aucun CORS à configurer, aucun risque de
#           contenu mixte, et le MÊME build fonctionne sur n'importe quel
#           domaine — pratique pour un VPS de test dont l'adresse change.
#
#   URL   → backend sur un autre domaine, par exemple :
#           VITE_API_BASE_URL=https://api.exemple.mg
#           Dans ce cas le backend doit autoriser l'origine du frontend
#           (APP_CORS_ALLOWED_ORIGINS), et les deux doivent être en HTTPS,
#           sinon le navigateur bloque les appels et le WebSocket.
VITE_API_BASE_URL=
